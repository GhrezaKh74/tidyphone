    <!-- Onboarding -->
    <string name="onb1_title">See what\'s filling your phone</string>
    <string name="onb1_body">TidyPhone indexes your Downloads, photos, documents and chat media, then finds duplicates, junk and forgotten big files right on your device.</string>
    <string name="onb2_title">Let AI sort the mess</string>
    <string name="onb2_body">Your own AI model (Claude, OpenAI, OpenRouter, Ollama…) suggests folders, clean names and what is safe to remove, using only file names, sizes and dates.</string>
    <string name="onb3_title">Nothing happens without you</string>
    <string name="onb3_body">You review every change. Deleted files go to a Trash you control, and every action can be undone from History.</string>
    <string name="perm_title">Allow access to your files</string>
    <string name="perm_body">To find duplicates and move files between folders, TidyPhone needs Android\'s \"All files access\". You\'ll be taken to system settings: turn it on for TidyPhone, then come back.</string>
    <string name="perm_point_review">Every delete, move and rename waits for your approval.</string>
    <string name="perm_point_protected">System folders, Android/data, Android/obb and your excluded folders are never touched.</string>
    <string name="perm_point_metadata">The AI receives metadata only, unless you opt in to content analysis for a run.</string>
    <string name="perm_grant">Grant access</string>
    <string name="perm_granted">Access granted</string>
    <string name="get_started">Get started</string>
    <string name="perm_denied_title">Access is still off</string>
    <string name="perm_denied_body">TidyPhone can\'t see your files without it. You can turn it on any time in Settings › Apps › TidyPhone › All files access.</string>

