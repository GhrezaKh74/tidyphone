    <string name="rules_examples">Examples</string>
    <string name="rule_ex1">Put invoices and receipts in Documents/Finance</string>
    <string name="rule_ex2">Never suggest deleting voice notes</string>
    <string name="rule_ex3">Keep university files in Documents/University</string>
    <string name="rules_excludes">Excluded folders</string>
    <string name="rules_excludes_desc">Enforced in code: these folders are never scanned, moved, renamed or deleted, whatever the AI says.</string>
    <string name="rules_always_protected">Always protected: Android/data, Android/obb, app-private folders and system folders.</string>
